{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "APPLICATION_NAME": "SAP_MANGEMENT",

    "keycloak": {
        "AuthprizationUrl": "http://localhost:7200/realms/sap-mangement/protocol/openid-connect/auth",
        "TokenUrl": "http://keycloak:8080/realms/sap-mangement/protocol/openid-connect/token",
        "Grant_type": "password",
        "Grant_type_refresh_token": "refresh_token"
    },
    "Authentication": {
        "MetadataAddress": "http://keycloak:8080/realms/sap-mangement/.well-known/openid-configuration",
        "ValidIssuer": "http://localhost:7200/realms/sap-mangement",
        "Audience": "account"
    }
}